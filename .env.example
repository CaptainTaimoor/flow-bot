# App Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Flow Configuration
FLOW_URL=https://flow.google.com/
# Mode can be TEST_MODE or NORMAL_MODE
FLOW_GENERATION_MODE=TEST_MODE
FLOW_PROJECT_MODE=REUSE_SINGLE_PROJECT
AUTO_CONFIRM_GENERATION=false

# Default settings
DEFAULT_MODEL=veo
DEFAULT_ORIENTATION=16:9
DEFAULT_DURATION=5
DEFAULT_OUTPUTS=1

# Limits & Safety
MAX_GENERATIONS_PER_JOB=1
MAX_GENERATIONS_PER_SESSION=10
MAX_DAILY_GENERATIONS=20

# Timeouts (seconds)
GENERATION_TIMEOUT=600
BROWSER_TIMEOUT=60
DOWNLOAD_TIMEOUT=300

# Retries
RETRY_COUNT=2
RETRY_BACKOFF=30
CONCURRENCY=1

# Paths
BROWSER_PROFILE_DIR=runtime/profile
OUTPUT_DIR=output
DIAGNOSTICS_DIR=diagnostics

# Misc
SCREENSHOT_ON_FAILURE=true
HEADLESS=false
